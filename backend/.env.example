# =========================================================================
# GeoCadastre-3D Backend — Environment Configuration Template (.env.example)
# =========================================================================
# Copy this file to .env and adjust variables as needed for deployment.
# NEVER commit real credentials, passwords, or production secrets to Git.

# -------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -------------------------------------------------------------------------
# Default (Development): Local SQLite database file
DATABASE_URL=sqlite:///./geocadastre3d.db

# Production Example (PostgreSQL with PostGIS capability):
# DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>

# -------------------------------------------------------------------------
# APPLICATION SERVER CONFIGURATION
# -------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# -------------------------------------------------------------------------
# CORS SECURITY CONFIGURATION
# -------------------------------------------------------------------------
# Default (Development): Wildcard origin (*)
CORS_ORIGINS=*

# Production Example (Explicit comma-separated origin whitelist):
# CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://geocadastre3d.gov.in
